PORT=3001
NODE_ENV=development

# Banco de dados
# Use um usuário dedicado com privilégios mínimos (SELECT, INSERT,
# UPDATE, DELETE) no schema da aplicação — nunca root em produção.
DB_HOST=localhost
DB_USER=coursehub_app
DB_PASSWORD=changeme
DB_NAME=coursehub_escola

# Autenticação
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / links do frontend
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP) — deixe em branco em dev para usar uma conta de teste
# automática (Ethereal). Preencha para usar um provedor real em produção.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CourseHub <no-reply@coursehub.local>

# Gateway de pagamento
PAYMENT_GATEWAY=simulated
